{
  "name": "tokguess-copilot",
  "displayName": "TokGuess",
  "description": "Track Copilot, Claude & Antigravity CLI tokens + Context Budget alerts before you send. Dashboard, optional local OTel precision mode (auth-protected, localhost-only), zero cloud.",
  "version": "0.6.4",
  "publisher": "maazizit",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "galleryBanner": {
    "color": "#f8b4d9",
    "theme": "light"
  },
  "icon": "media/icon.png",
  "keywords": [
    "copilot",
    "claude",
    "antigravity",
    "gemini",
    "tokens",
    "estimate",
    "tokguess",
    "dashboard",
    "cost",
    "context",
    "budget"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokguess",
          "title": "TokGuess",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "tokguess": [
        {
          "type": "webview",
          "id": "tokguess.dashboard",
          "name": "Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "tokguess.openPanel",
        "title": "Open Dashboard",
        "category": "TokGuess",
        "icon": "$(graph)"
      },
      {
        "command": "tokguess.rescan",
        "title": "Rescan Logs",
        "category": "TokGuess"
      },
      {
        "command": "tokguess.toggle",
        "title": "Toggle TokGuess",
        "category": "TokGuess"
      },
      {
        "command": "tokguess.checkBudget",
        "title": "Check Context Budget",
        "category": "TokGuess"
      },
      {
        "command": "tokguess.countCurrentFile",
        "title": "Check Context Budget",
        "category": "TokGuess"
      },
      {
        "command": "tokguess.showStats",
        "title": "Show Dashboard",
        "category": "TokGuess"
      },
      {
        "command": "tokguess.openEnhancedDashboard",
        "title": "Open Enhanced Dashboard",
        "category": "TokGuess",
        "icon": "$(graph-line)"
      },
      {
        "command": "tokguess.optimizeContext",
        "title": "Optimize Context",
        "category": "TokGuess",
        "icon": "$(zap)"
      },
      {
        "command": "tokguess.showAnalytics",
        "title": "Show Analytics",
        "category": "TokGuess",
        "icon": "$(graph)"
      },
      {
        "command": "tokguess.checkDailyBudget",
        "title": "Check Daily Budget",
        "category": "TokGuess"
      },
      {
        "command": "tokguess.showLearningInsights",
        "title": "Show Learning Insights",
        "category": "TokGuess"
      },
      {
        "command": "tokguess.exportReport",
        "title": "Export Report",
        "category": "TokGuess",
        "icon": "$(export)"
      },
      {
        "command": "tokguess.showBlockInfo",
        "title": "Show Block Info",
        "category": "TokGuess"
      },
      {
        "command": "tokguess.checkCacheUsage",
        "title": "Check Cache Usage",
        "category": "TokGuess"
      },
      {
        "command": "tokguess.showCacheStats",
        "title": "Show Cache Stats",
        "category": "TokGuess"
      },
      {
        "command": "tokguess.copyTokenCount",
        "title": "Copy Token Count",
        "category": "TokGuess",
        "icon": "$(copy)"
      },
      {
        "command": "tokguess.enablePrecision",
        "title": "Enable Precision Mode (Copilot OTel)",
        "category": "TokGuess",
        "icon": "$(target)"
      },
      {
        "command": "tokguess.disablePrecision",
        "title": "Disable Precision Mode",
        "category": "TokGuess"
      },
      {
        "command": "tokguess.collectorStatus",
        "title": "Collector Status",
        "category": "TokGuess"
      }
    ],
    "keybindings": [
      {
        "command": "tokguess.openPanel",
        "key": "ctrl+shift+t",
        "mac": "ctrl+shift+t"
      }
    ],
    "configuration": {
      "title": "TokGuess",
      "properties": {
        "tokguess.sources.copilot.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Watch Copilot session logs (~/.copilot/session-state)"
        },
        "tokguess.sources.copilot.path": {
          "type": "string",
          "default": "",
          "description": "Custom Copilot session-state path (empty = default)"
        },
        "tokguess.sources.copilot.logWatcher": {
          "type": "boolean",
          "default": true,
          "description": "Watch VS Code Copilot Chat.log for requests (works without session-state)"
        },
        "tokguess.sources.copilot.logPath": {
          "type": "string",
          "default": "",
          "description": "Custom VS Code logs path (empty = ~/Library/Application Support/Code/logs)"
        },
        "tokguess.sources.copilot.logTodayOnly": {
          "type": "boolean",
          "default": true,
          "description": "Ingest only today's Copilot Chat.log lines (recommended after Rescan)"
        },
        "tokguess.sources.claude.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Watch Claude Code JSONL logs (~/.claude/projects)"
        },
        "tokguess.sources.claude.path": {
          "type": "string",
          "default": "",
          "description": "Custom Claude logs root path (empty = default)"
        },
        "tokguess.sources.antigravity.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Watch Antigravity CLI transcripts (~/.gemini/antigravity-cli/brain)"
        },
        "tokguess.sources.antigravity.path": {
          "type": "string",
          "default": "",
          "description": "Custom Antigravity brain root path (empty = default)"
        },
        "tokguess.budget.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Context Budget in status bar and dashboard"
        },
        "tokguess.budget.threshold": {
          "type": "number",
          "default": 32000,
          "description": "Max estimated tokens before send alert (default 32k)"
        },
        "tokguess.budget.warnPercent": {
          "type": "number",
          "default": 75,
          "minimum": 50,
          "maximum": 99,
          "description": "Warn when context reaches this % of threshold"
        },
        "tokguess.budget.alerts": {
          "type": "boolean",
          "default": true,
          "description": "Show popup when approaching or exceeding budget"
        },
        "tokguess.budget.monthly_cost_usd": {
          "type": "number",
          "default": 20,
          "description": "Monthly budget limit in USD"
        },
        "tokguess.budget.daily_tokens": {
          "type": "number",
          "default": 50000,
          "description": "Daily token limit"
        },
        "tokguess.budget.per_file_tokens": {
          "type": "number",
          "default": 5000,
          "description": "Maximum tokens per file context"
        },
        "tokguess.budget.hard_limit": {
          "type": "boolean",
          "default": false,
          "description": "Block requests when budget exceeded"
        },
        "tokguess.codelens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline token estimates for functions and classes"
        },
        "tokguess.codelens.warningThreshold": {
          "type": "number",
          "default": 2000,
          "description": "Show warning icon when function/class exceeds this token count"
        },
        "tokguess.precision.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Use OTel local collector for real Copilot token counts"
        },
        "tokguess.precision.collectorPort": {
          "type": "number",
          "default": 4318,
          "description": "OTLP HTTP port for local collector"
        },
        "tokguess.precision.apiPort": {
          "type": "number",
          "default": 4319,
          "description": "Read API port for local collector"
        },
        "tokguess.precision.retentionDays": {
          "type": "number",
          "default": 7,
          "description": "Days to retain OTel spans locally"
        },
        "tokguess.precision.autoFallback": {
          "type": "boolean",
          "default": true,
          "description": "Fall back to Chat.log estimation if OTel is silent"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@types/chart.js": "^2.9.41",
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maazizit/tokguess.git"
  },
  "bugs": {
    "url": "https://github.com/maazizit/tokguess/issues"
  },
  "homepage": "https://github.com/maazizit/tokguess#readme",
  "license": "MIT",
  "author": {
    "name": "Zahra Maaziz",
    "email": "zahra.maaziz@gmail.com"
  }
}
